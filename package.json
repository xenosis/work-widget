{
  "name": "work-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Windows tray-resident work widget (projects/todos/memos/schedule)",
  "author": "sewoong",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "dist": "vite build && electron-builder",
    "lint": "eslint .",
    "test": "vitest run",
    "backlog:dashboard": "node tools/serve-dashboard.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "app.workwidget.desktop",
    "productName": "업무 위젯",
    "executableName": "work-widget",
    "files": [
      "dist/**",
      "electron/**",
      "!electron/**/*.test.js",
      "!electron/assets/app-icon.ico"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/assets/app-icon.ico"
    }
  }
}
